# Modèle pour terraform.tfvars.
# Au début de chaque session de lab :
#   cp terraform.tfvars.example terraform.tfvars
# puis remplacer les deux valeurs ci-dessous.
# Ne jamais mettre terraform.tfvars dans Git (il est dans le .gitignore).

# ID du projet : dans le panneau du lab, ou avec "gcloud config get-value project".
project_id = "REMPLACER_PAR_LE_PROJECT_ID_DU_LAB"

# Région : dans le panneau du lab (exemple : us-central1).
region = "REMPLACER_PAR_LA_REGION_DU_LAB"

# Les autres variables ont une valeur par défaut dans variables.tf
# (cluster_name, network, subnetwork, release_channel...).
