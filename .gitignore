
# Fichiers à ne jamais mettre dans Git.

# --------------------------------------------
# Terraform : dossier local et providers téléchargés
# --------------------------------------------
**/.terraform/

# State Terraform
*.tfstate
*.tfstate.*

# Fichiers de variables (contiennent l'ID du projet du lab)
**/*.tfvars
**/*.tfvars.json

# Plans Terraform
*.tfplan

# Logs de crash Terraform
crash.log
crash.*.log

# On garde .terraform.lock.hcl dans Git

# --------------------------------------------
# Identifiants et configuration locale
# --------------------------------------------
.env
.env.*
!.env.example

# Configuration et identifiants Kubernetes
**/kubeconfig
**/kubeconfig.*
*.pem
*.key

# Identifiants Google Cloud
application_default_credentials.json
*service-account*.json

# --------------------------------------------
# Fichiers générés par Helm
# --------------------------------------------
helm/packages/
*.tgz

# --------------------------------------------
# Éditeurs et systèmes
# --------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# Fichiers temporaires Python
__pycache__/
*.pyc

# Fichiers temporaires et sauvegardes
*.tmp
*.bak
